sequenceDiagram
    autonumber
    actor Customer
    participant Gateway as API Gateway
    participant ResSvc as Reservation Service
    participant InvRepo as Inventory Repository
    participant DB as SQL Database
    participant Broker as Message Broker

    Customer->>Gateway: POST /api/v1/reservations (Idempotency-Key)
    Gateway->>Gateway: Validate Token Bucket Rate Limit
    Gateway->>ResSvc: reserve_stock(customer_id, product_id, qty, key)
    ResSvc->>DB: Check Idempotency Key
    alt Idempotency Key Reused
        DB-->>ResSvc: Return Existing Reservation
        ResSvc-->>Gateway: 200 OK (is_duplicate: true)
        Gateway-->>Customer: Return Cached Reservation
    else New Request
        ResSvc->>InvRepo: UPDATE inventory SET available = available - 1 WHERE product_id = X AND available >= 1
        DB-->>InvRepo: Affected Rows = 1
        alt Available >= 1 Success
            ResSvc->>DB: INSERT INTO inventory_reservations (RESERVED, 30s TTL)
            ResSvc->>DB: INSERT INTO outbox_events (INVENTORY_RESERVED)
            DB-->>ResSvc: Commit Transaction
            ResSvc->>Broker: Publish INVENTORY_RESERVED Event
            ResSvc-->>Gateway: 201 Created (reservation_id)
            Gateway-->>Customer: 201 Created
        else Available < 1 Out of Stock
            ResSvc-->>Gateway: 409 Conflict (OUT_OF_STOCK)
            Gateway-->>Customer: 409 Conflict
        end
    end

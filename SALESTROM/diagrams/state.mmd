stateDiagram-v2
    [*] --> AVAILABLE : Initial Product Stock (100)

    AVAILABLE --> RESERVED : Atomic Conditional UPDATE Success
    AVAILABLE --> REJECTED : Out of Stock (Available < 1)

    state RESERVED {
        [*] --> PAYMENT_PENDING
        PAYMENT_PENDING --> CONFIRMED : Payment Captured
        PAYMENT_PENDING --> RELEASED : Payment Failed / Cancelled
        PAYMENT_PENDING --> EXPIRED : 30s TTL Timeout
    }

    CONFIRMED --> SOLD : Order Created & Settled
    RELEASED --> AVAILABLE : Stock Returned to Pool
    EXPIRED --> AVAILABLE : Stock Returned to Pool
    REJECTED --> [*]
    SOLD --> [*]
